# Canonical origin used for metadata, sitemap and robots (no trailing slash).
# SITE_URL=https://palvadeau.ch

# Set to 1 to include the template sample projects in a build (always on in development).
SAMPLE_PROJECTS=

# Contact form. Never commit real values.
# Resend API key with sending access, and the address that receives the messages.
RESEND_API_KEY=
CONTACT_EMAIL=
# Sender shown to the owner; defaults to Resend's test sender until a domain is verified.
# CONTACT_FROM=Portfolio <contact@mail.palvadeau.ch>
# Cloudflare Turnstile: public site key (browser) and secret key (server only).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Spotify "now playing" in the footer: see docs/spotify-setup.md. Leave empty to hide it.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Phone number shown in the contact section, as people should read it. Leave empty to hide it.
NEXT_PUBLIC_CONTACT_PHONE=
