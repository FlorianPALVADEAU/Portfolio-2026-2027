{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci:lint": "biome ci .",
    "prepare": "lefthook install",
    "knip": "knip",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dependency-cruiser": "18.6.0",
    "knip": "6.41.0",
    "lefthook": "2.2.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "description": "Personal portfolio of Florian Palvadeau, full-stack software engineer",
  "engines": {
    "node": ">=24"
  }
}
