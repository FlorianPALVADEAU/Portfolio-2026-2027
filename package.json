{
  "name": "portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci:lint": "biome ci .",
    "prepare": "lefthook install",
    "knip": "knip",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@react-three/fiber": "^9.8.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "^4.1.2",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "^16.36.0",
    "tailwind-merge": "3.7.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.5",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/nextjs-vite": "^10.6.6",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "jsdom": "30.1.3",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "storybook": "^10.6.2",
    "tailwindcss": "^4",
    "typescript": "6.0.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "description": "Personal portfolio of Florian Palvadeau, full-stack software engineer",
  "engines": {
    "node": ">=24"
  }
}
